FROM postgres:12-alpine

# Install dependencies
# - restic: Backup tool (Alpine repositories have recent versions)
# - curl: Downloader
# - jq: JSON processor
# - gcompat: GLIBC compatibility layer (better than libc6-compat)
RUN apk add --no-cache restic curl jq gcompat

# Install CockroachDB client binary (Optional fallback, but good to have)
RUN curl -O https://binaries.cockroachdb.com/cockroach-v24.2.0.linux-amd64.tgz \
    && tar -xzf cockroach-v24.2.0.linux-amd64.tgz \
    && cp cockroach-v24.2.0.linux-amd64/cockroach /usr/local/bin/ \
    && rm -rf cockroach-v24.2.0.linux-amd64*

# Copy scripts
COPY scripts/backup-daemon.sh /scripts/backup-daemon.sh
COPY scripts/restore-entrypoint.sh /scripts/restore-entrypoint.sh

# Make executable
RUN chmod +x /scripts/*.sh

WORKDIR /backup
