FROM alpine:latest

# Install dependencies
# - restic: The backup tool
# - postgresql-client: pg_dump (if needed)
# - curl: to download cockroach binary
# - jq: for JSON parsing in scripts
# - libc6-compat: required for cockroach binary on alpine
RUN apk add --no-cache restic postgresql-client curl jq libc6-compat

# Install CockroachDB client binary (for specialized dump)
# We use the same version as the main container to avoid compatibility issues
RUN curl -O https://binaries.cockroachdb.com/cockroach-v24.2.0.linux-amd64.tgz \
    && tar -xzf cockroach-v24.2.0.linux-amd64.tgz \
    && cp cockroach-v24.2.0.linux-amd64/cockroach /usr/local/bin/ \
    && rm -rf cockroach-v24.2.0.linux-amd64*

# Copy scripts
COPY scripts/backup-daemon.sh /scripts/backup-daemon.sh
COPY scripts/restore-entrypoint.sh /scripts/restore-entrypoint.sh

# Make executable
RUN chmod +x /scripts/*.sh

WORKDIR /backup
